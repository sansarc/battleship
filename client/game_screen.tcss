GameScreen {
    layout: vertical;
    width: 100%;
    height: 100%;
}

#match-header {
    dock: top;
    height: 3;
    background: $boost;
    content-align: center middle;
    text-style: bold;
}

#boards {
    height: 1fr;
    width: 100%;
}

.board-pane {
    width: 44;
    min-width: 44;
    border: solid $primary;
    padding: 1;
}


.board-title {
    height: 1;
    content-align: center middle;
    text-style: bold underline;
    margin-bottom: 1;
}

.board-grid {
    grid-size: 10 10;
    grid-gutter: 0 0;
    width: 40;
    height: 20;
}

GridCell {
    width: 4;
    height: 2;
    min-width: 4;
    border: none;
    margin: 0;
    padding: 0;
}

GridCell.cell-ship {
    background: $success;
}

GridCell.cell-hit {
    background: $error;
    color: $text;
    text-style: bold;
}

GridCell.cell-miss {
    background: $panel;
    color: $text-muted;
}

#game-log {
    width: 1fr;
    min-width: 40;
    border: solid $secondary;
}

#side-panel {
    height: 7;
    border: solid $secondary;
    padding: 1;
}

#status-label {
    width: 1fr;
}

#button-row {
    width: auto;
    margin-right: 2;
}

#button-row Button {
    width: 25;
    margin-right: 1;
}

#legend-label {
    width: 32;
    color: $text-muted;
    margin-right: 2;
}